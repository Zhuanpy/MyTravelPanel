# 数据库配置
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=travelindustry
DB_NAME_DATA=traveldata

# Flask 安全配置（生产环境必须改为强随机字符串）
SECRET_KEY=your_super_secret_key_here
FLASK_ENV=development

# 邮件服务器配置（阿里云企业邮箱默认 SSL/465）
MAIL_SERVER=smtp.qiye.aliyun.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@example.com

# 待办事项通知配置
TODO_NOTIFICATION_ENABLED=True
TODO_CHECK_INTERVAL=3600
TODO_EMAIL_INTERVAL=7200
TODO_EMAIL_THRESHOLD=24
TODO_DESKTOP_NOTIFICATION=True

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0

# 第三方服务 API 密钥
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
WEATHER_API_KEY=your_weather_api_key
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key
# 航班数据 API（RapidAPI / Aerodatabox、Aviationstack）
RAPIDAPI_KEY=your_rapidapi_key
AVIATIONSTACK_API_KEY=your_aviationstack_key

# 日志级别
LOG_LEVEL=INFO
