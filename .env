# 鏁版嵁搴撻厤缃紙闃块噷浜慚ySQL锛?DB_USER=your_aliyun_rds_username
DB_PASSWORD=your_aliyun_rds_password
DB_HOST=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=travelindustry
DB_NAME_DATA=traveldata

# Flask 瀹夊叏閰嶇疆
SECRET_KEY=please_replace_with_secure_random_value

# 閭欢鏈嶅姟鍣ㄩ厤缃?- 闃块噷浜戜紒涓氶偖绠?MAIL_SERVER=smtp.qiye.aliyun.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=info@joyesc.com
MAIL_PASSWORD=***REMOVED***
MAIL_DEFAULT_SENDER=info@joyesc.com

# 榛樿鏀朵欢浜洪偖绠?DEFAULT_EMAIL_RECIPIENT=info@joyesc.com
DEFAULT_EMAIL_RECIPIENTS=admin@joyesc.com,info@joyesc.com

# 绗笁鏂规湇鍔PI 瀵嗛挜
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
WEATHER_API_KEY=your_weather_api_key
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key

# Redis 閰嶇疆锛堝彲閫夛級
REDIS_URL=redis://localhost:6379/0

# 寰呭姙浜嬮」閫氱煡閰嶇疆
TODO_NOTIFICATION_ENABLED=True
TODO_CHECK_INTERVAL=21600
TODO_EMAIL_INTERVAL=43200
TODO_EMAIL_THRESHOLD=24
TODO_DESKTOP_NOTIFICATION=True

# Flask 鐜
FLASK_ENV=development
