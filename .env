# 数据库配置（阿里云 MySQL）
# 可直接填写域名:端口，或使用下面的 DB_PORT 单独指定端口
DB_USER=your_aliyun_rds_username  # 需更改
DB_PASSWORD=your_aliyun_rds_password  # 需更改
DB_HOST=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com  # 需更改（不含端口也可）
DB_PORT=3306
DB_NAME=travelindustry  # 如不同，需更改
DB_NAME_DATA=traveldata  # 如不同，需更改或与 DB_NAME 保持一致

# Flask 安全配置
SECRET_KEY=please_replace_with_secure_random_value  # 生产需更改

# 邮件服务器配置
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=joyfulescape.direct@gmail.com
MAIL_PASSWORD=***REMOVED***

# 默认收件人邮箱（当无法获取经办人邮箱时使用）
DEFAULT_EMAIL_RECIPIENT=651748264@qq.com  # 生产需更改

# 多个默认收件人邮箱（用逗号分隔，优先级高于单个默认收件人）
DEFAULT_EMAIL_RECIPIENTS=zhangzhuan516@gmail.com  # 生产需更改

# 第三方服务 API 密钥
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
WEATHER_API_KEY=your_weather_api_key
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0

# 待办事项通知配置
TODO_NOTIFICATION_ENABLED=True
TODO_CHECK_INTERVAL=21600
TODO_EMAIL_INTERVAL=43200
TODO_EMAIL_THRESHOLD=24
TODO_DESKTOP_NOTIFICATION=True

# Flask 环境
FLASK_ENV=development  # 配置稳定后可改为 production